{
  "name": "whatsapp-ai-agent-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Agente de WhatsApp con IA — kit completo para desplegar en una tarde",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 4311",
    "build": "next build",
    "start": "next start -p 4311",
    "start:bot": "tsx scripts/start-bot.ts",
    "start:qr": "tsx scripts/start-qr.ts",
    "start:all": "concurrently --kill-others --names BOT,WEB --prefix-colors yellow,cyan \"npm run start:bot\" \"npm run start\"",
    "intelligence:worker": "tsx scripts/intelligenceWorker.ts",
    "bootstrap:vida-divina": "tsx scripts/bootstrapVidaDivinaProject.ts",
    "wizard": "tsx scripts/wizard.ts",
    "check": "tsx scripts/check-system.ts",
    "doctor": "tsx scripts/doctor.ts",
    "redteam": "tsx scripts/redteam.mts",
    "test:airtable": "tsx scripts/test-airtable.mts",
    "test": "cross-env HERMES_TEST_MODE=1 tsx --test --experimental-test-module-mocks test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next data auth"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@whiskeysockets/baileys": "^6.7.21",
    "better-sqlite3": "^12.10.0",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "enquirer": "^2.4.1",
    "next": "^16.2.6",
    "openai": "^6.38.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}

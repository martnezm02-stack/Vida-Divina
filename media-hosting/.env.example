# media-hosting/.env.example
# Plantilla sin secretos — SÍ se versiona. Un .env real con valores reales
# NUNCA se versiona (cubierto por **/*.env en el .gitignore de la raíz).
#
# Ninguna de estas variables tiene un valor configurado en este repositorio
# hoy. Sin ellas, MediaHostingService devuelve CONFIGURATION_REQUIRED en
# toda operación real (upload/exists/delete) -- nunca intenta la red ni
# inventa un valor por defecto.

# Id de cuenta de Cloudflare (el host real es
# `${R2_ACCOUNT_ID}.r2.cloudflarestorage.com`). Se obtiene en el dashboard
# de Cloudflare, sección R2.
R2_ACCOUNT_ID=

# Access Key ID / Secret Access Key del token de API de R2. Se generan en
# Cloudflare Dashboard -> R2 -> "Manage R2 API Tokens" -> Create API Token,
# con permisos "Object Read & Write" sobre el bucket real de este proyecto.
# NUNCA se hardcodean en código ni se loguean.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket real (creado de antemano en Cloudflare Dashboard -> R2).
R2_BUCKET=

# URL pública base del bucket -- SIN esta variable no hay forma real de dar
# a Meta una URL https pública, aunque el resto de credenciales exista.
# Dos formas válidas:
#   1) Dominio r2.dev habilitado para el bucket (Cloudflare Dashboard -> R2
#      -> bucket -> Settings -> "Public access" -> "Allow Access", copiar
#      la URL `https://pub-xxxxxxxx.r2.dev`).
#   2) Un dominio propio conectado al bucket (Cloudflare Dashboard -> R2 ->
#      bucket -> Settings -> "Custom Domains").
# Sin barra final.
R2_PUBLIC_BASE_URL=

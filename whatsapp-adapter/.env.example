# Plantilla de variables de entorno del adaptador — copia este archivo a
# ".env" (mismo directorio) y rellena los valores reales. ".env" está
# excluido en el .gitignore de la raíz del repositorio: nunca debe
# llegar a un commit.
#
# Uso: node --env-file=.env server.js

# --- Verificación del webhook (obligatoria) --------------------------------
# Valor arbitrario elegido por ti. Debe coincidir EXACTAMENTE con el
# "Verify Token" que registres en Meta App Dashboard > WhatsApp >
# Configuration > Webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Firma de las solicitudes entrantes (opcional pero recomendada) -------
# App Secret de la app "Vive Vida Divina" (App Dashboard > Configuración de
# la app > Básica > Clave secreta de la app). Si se define, cada POST se
# valida contra el header x-hub-signature-256 antes de procesarse.
WHATSAPP_APP_SECRET=

# --- Envío real (opcional — sin esto, el adaptador solo recibe/procesa) ---
# Token de acceso de Meta (System User recomendado). NUNCA pegues este
# valor en un chat, ni lo compartas fuera de este archivo local.
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID DESDE el que se envían los mensajes. Para pruebas de
# desarrollo usa el Phone Number ID del NÚMERO DE PRUEBA de Meta (App
# Dashboard > WhatsApp > Configuración de la API) — no el número real,
# que sigue sin conectar a Cloud API (ver docs/WHATSAPP_INTEGRATION_STATE.md).
WHATSAPP_PHONE_NUMBER_ID=

# Versión de Graph API a usar (opcional).
WHATSAPP_GRAPH_API_VERSION=v21.0

# --- Servidor ---------------------------------------------------------------
PORT=3000

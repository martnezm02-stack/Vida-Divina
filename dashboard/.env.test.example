# dashboard/.env.test.example — copia a dashboard/.env.test (gitignored)
# para que "npm test" siga funcionando. Requerido por dashboard/package.json
# #scripts.test.
#
# DASHBOARD_TEST_BYPASS_AUTH=1 hace que TODA request dentro de un proceso de
# test se trate como ya autenticada (rol ADMIN) -- necesario porque los 21
# archivos de test HTTP ya existentes en dashboard/test/ (autoPublish.test.js,
# inventory.test.js, etc., de fases anteriores a la autenticación) golpean
# la API real sin sesión; exigirles autenticarse habría significado tocar
# cada uno de esos archivos para una fase que es exclusivamente
# autenticación (ver FASE "Autenticación nativa del Dashboard", 2026-09-19).
#
# dashboard/test/auth.test.js -- los tests REALES de autenticación -- borra
# esta variable de su propio proceso ANTES de importar el servidor, así que
# SÍ ejercitan la puerta real, nunca este bypass. Ver server/lib/session.js.
#
# Esta variable NUNCA debe estar puesta en producción (no la agrega
# "npm start", solo "npm test") -- si algún día se pone por error, TODA
# request quedaría autenticada sin login real: tratarlo como una fuga de
# seguridad real, no como una variable inocua.

DASHBOARD_TEST_BYPASS_AUTH=1

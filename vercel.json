{
  "version": 2,
  "name": "vive-vida-divina",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/products/(.*)\\.(webp|png|jpg|jpeg|svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)\\.(mp4|webm|mov|m4v)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/logo.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(site\\.css|site\\.js|catalog\\.json|i18n\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}

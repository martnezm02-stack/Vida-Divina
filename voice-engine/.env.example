# Copiar a .env (ya cubierto por .gitignore raiz: **/*.env) y completar.
# Nunca poner valores reales de VOICE_ENGINE_API_KEY en este archivo.

CHATTERBOX_DEVICE=cpu
VOICE_ENGINE_HOST=127.0.0.1
VOICE_ENGINE_PORT=8000
VOICE_ENGINE_API_KEY=cambia-esto-por-una-clave-generada

# Opcional -- por defecto usa ~/vida-divina-voice-engine-data
# VOICE_DATA_DIR=/home/tu-usuario/vida-divina-voice-engine-data

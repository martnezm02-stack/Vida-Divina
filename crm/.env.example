# crm/.env.example
# Plantilla sin secretos — SÍ se versiona. crm/.env (con valores reales)
# NUNCA se versiona (cubierto por **/*.env en el .gitignore de la raíz).
#
# crm/ es el ÚNICO módulo autorizado a hablar con PostgreSQL directamente
# (Decisión Arquitectónica #6 — ver docs/ARCHITECTURE_v1.md §11 y
# docs/PROJECT_STATE.md §6, y el detalle completo en
# docs/CRM_FASE_B_POSTGRESQL.md). Ningún otro módulo debe leer ni importar
# estas variables.

# Cadena de conexión de PostgreSQL para desarrollo/producción de crm/.
# Formato: postgres://usuario:password@host:puerto/nombre_de_base
#
# Se usa DATABASE_URL (en vez de DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD
# por separado) porque es la convención estándar que la mayoría de
# proveedores de PostgreSQL administrado inyectan automáticamente — evita
# tener que traducir variables si el proyecto se despliega en un servicio
# que ya provee DATABASE_URL. No hay ninguna convención previa en el
# proyecto que entre en conflicto (ningún otro módulo habla con una base de
# datos hoy).
DATABASE_URL=postgres://usuario:password@localhost:5432/vida_divina_crm

# Cadena de conexión de una base de datos PostgreSQL SEPARADA, exclusiva
# para los tests de integración de crm/test/. NUNCA debe apuntar a la misma
# base que DATABASE_URL — los tests borran datos entre casos (ver
# crm/test/helpers/db.js). Requerida solo para correr "npm test" dentro de
# crm/; no es necesaria para usar el módulo en runtime normal.
TEST_DATABASE_URL=postgres://usuario:password@localhost:5432/vida_divina_crm_test

# Opcionales — el módulo funciona con valores por defecto razonables si se
# omiten (ver crm/config/env.js).
CRM_DB_POOL_MAX=10
CRM_DB_SSL=false
CRM_DB_IDLE_TIMEOUT_MS=30000
CRM_DB_CONNECTION_TIMEOUT_MS=5000

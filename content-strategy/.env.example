# Plantilla sin secretos — SÍ se versiona. content-strategy/.env (con
# valores reales) NUNCA se versiona (cubierto por **/*.env en el
# .gitignore de la raíz).
#
# Variables reconocidas por content-strategy/src/instagramConfig.js —
# usadas por instagramAccountReader.js, instagramMediaReader.js,
# instagramInsightsReader.js, instagramPublicationAdapter.js e
# instagramPerformanceSource.js.

# Token de acceso OAuth de Meta (Graph API). NUNCA pegar el valor real en
# un chat, ni compartirlo fuera de este archivo local.
INSTAGRAM_ACCESS_TOKEN=

# ID de la cuenta profesional de Instagram conectada a la Página de
# Facebook. Confirmado: @vive_vidadivina.
INSTAGRAM_IG_USER_ID=17841439252107168

# Versión de Graph API. IMPORTANTE: no se deja ningún valor por defecto
# aquí a propósito — usa exactamente la misma versión que confirmaste
# funcional en Graph API Explorer (revisa el selector de versión en la
# esquina superior de esa herramienta). Debe ser v22.0 o posterior (Meta
# confirmó que "impressions" ya no está soportada desde v22.0 en
# adelante, OAuthException 100). Si se deja vacía, el código usará el
# default interno de instagramConfig.js (v21.0) — NO CONFIRMADO para esta
# cuenta, no recomendado sin verificar antes.
INSTAGRAM_GRAPH_API_VERSION=
